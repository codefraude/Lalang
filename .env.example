# ---------------------------------------------------------------------------
# Lalang environment variables
# Copy this file to `.env` and fill in what you need.
# The app RUNS with none of these set (offline dictionary + no auth), and
# gets progressively more capable as you add them.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required for history, auth, community features).
# Example for a local Postgres install:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lalang?schema=public"

# --- Auth (NextAuth / Auth.js) ---------------------------------------------
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Base URL of the app (only needed in production / non-localhost).
# NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — enables "Sign in with Google").
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Seeded admin account (used by `prisma db seed`). Set a STRONG password in
# production before exposing the app — the defaults are for local dev only.
ADMIN_EMAIL="admin@lalang.mu"
ADMIN_PASSWORD=""

# --- AI translation (optional) ---------------------------------------------
# Without this the app uses the offline dictionary. With it, translations are
# produced by the AI stage and are far more fluent.
#
# Works with ANY OpenAI-compatible provider — set OPENAI_BASE_URL to switch.
# Free options (create a key, then paste it into OPENAI_API_KEY):
#   GitHub  PAT w/ "models: read" at https://github.com/settings/personal-access-tokens/new
#           -> OPENAI_BASE_URL="https://models.github.ai/inference"  OPENAI_MODEL="openai/gpt-4o-mini"
#   Groq    https://console.groq.com  -> OPENAI_BASE_URL="https://api.groq.com/openai/v1"          OPENAI_MODEL="llama-3.3-70b-versatile"
#   Gemini  https://aistudio.google.com/apikey -> OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai" OPENAI_MODEL="gemini-2.0-flash"
#   Mistral https://console.mistral.ai -> OPENAI_BASE_URL="https://api.mistral.ai/v1"              OPENAI_MODEL="mistral-small-latest"
#   Ollama  (local, no key)            -> OPENAI_BASE_URL="http://localhost:11434/v1"             OPENAI_MODEL="llama3.1"  and OPENAI_API_KEY="ollama"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
