# ---------------------------------------------------------------------------
# Lalang environment variables — copy to `.env` and fill in what you need.
#
# The app RUNS with none of the optional ones set and gets progressively more
# capable as you add them:
#   • no DATABASE_URL  → offline dictionary only, no accounts
#   • no AUTH_SECRET   → auth disabled
#   • no RESEND_API_KEY→ verification/reset emails are logged to the server
#                        console instead of sent (fully testable locally)
#   • no GOOGLE_*      → "Continue with Google" / One Tap hidden
#   • no OPENAI_*      → dictionary translation instead of AI
#   • no UPSTASH_*     → rate limiting & the AI cache fall back to in-memory
#                        (fine for one instance; use Upstash on Vercel/serverless)
# ---------------------------------------------------------------------------

# --- Database (required for auth & everything below) -----------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/lalang?schema=public"

# --- Auth.js / NextAuth ----------------------------------------------------
# Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-32-byte-random-secret"
# Public origin of the app. Used for email links, WebAuthn origin, cookies.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Two-factor (TOTP) -----------------------------------------------------
# 32-byte base64 key used to encrypt TOTP secrets at rest (AES-256-GCM).
# Generate with:  openssl rand -base64 32
# If omitted, a key is derived from AUTH_SECRET (fine for dev; set a dedicated
# key in production and keep it OUT of the database host).
TOTP_ENC_KEY=""

# --- Transactional email (Resend) ------------------------------------------
# Get a key at https://resend.com. When empty, emails are logged to the server
# console (the verification/reset links are printed) so every flow is testable.
RESEND_API_KEY=""
# Verified sender. The shared onboarding@resend.dev only delivers to your own
# verified address; use your domain in production.
EMAIL_FROM="Lalang <onboarding@resend.dev>"

# --- Google OAuth + One Tap (optional) -------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI:  {AUTH_URL}/api/auth/callback/google
# Authorised JS origin:     {AUTH_URL}
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Same value as GOOGLE_CLIENT_ID, exposed to the browser for One Tap.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# --- AI translation (optional) ---------------------------------------------
# Any OpenAI-compatible endpoint works — just change OPENAI_BASE_URL/MODEL:
#   • GitHub Models (free): PAT with "models: read" at
#     https://github.com/settings/personal-access-tokens/new
#     BASE_URL=https://models.inference.ai.azure.com
#   • OpenAI, Groq, OpenRouter, Mistral, Gemini (OpenAI-compat), Ollama (local)…
# For a language-preservation product, translation quality matters most, so the
# default is the flagship model rather than a mini. Identical requests are cached,
# so repeats are free and fast (see UPSTASH_* below for a shared cache).
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-5.5"
# Reasoning models (gpt-5*, o-series) take reasoning_effort instead of a
# temperature — low keeps the streaming translator responsive. Ignored by
# classic chat models such as gpt-4.1 or gpt-5.2-chat-latest.
OPENAI_REASONING_EFFORT="high"

# --- Rate limiting + AI cache (optional, recommended on serverless) --------
# Upstash Redis gives a SHARED store so the rate limiter actually holds across
# lambdas/cold starts, and the translation cache is warm across instances.
# Without these, both fall back to per-instance in-memory (fine for one server).
# Create a database at https://console.upstash.com and copy its REST creds.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Text-to-speech / voice (optional) -------------------------------------
# Powers the 🔊 "listen" buttons (dictionary, translator, learn cards). The
# browser has no Kreol Morisien voice and falls back to a robotic French one;
# ElevenLabs' multilingual model pronounces Kreol far more naturally. When empty,
# the app degrades to that built-in browser voice automatically.
# Get a key (free tier available) at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=""
# Voice to use. Default is the stock "Rachel" voice; pick one from your account
# (https://elevenlabs.io/app/voice-lab) — a French-native voice reads Kreol best.
ELEVENLABS_VOICE_ID=""
# Optional per-language overrides (fall back to ELEVENLABS_VOICE_ID):
# ELEVENLABS_VOICE_ID_MFE=""
# ELEVENLABS_VOICE_ID_FR=""
# ELEVENLABS_VOICE_ID_EN=""
# Model. eleven_multilingual_v2 = richest tone. eleven_turbo_v2_5 additionally
# accepts a forced pronunciation language (below) — more accurate on short words.
ELEVENLABS_MODEL="eleven_turbo_v2_5"
# Force how words are pronounced (ISO 639-1). Kreol is French-based, so read it
# with French rules. Only honoured by turbo/flash v2.5 models.
ELEVENLABS_LANGUAGE_CODE_MFE="fr"
ELEVENLABS_LANGUAGE_CODE_FR="fr"
ELEVENLABS_LANGUAGE_CODE_EN="en"
# Voice quality knobs (optional — sensible defaults apply if unset):
#   ELEVENLABS_STABILITY        0=expressive … 1=flat (0.4–0.6 sounds natural)
#   ELEVENLABS_SIMILARITY_BOOST higher = closer to the voice, crisper (0.85)
#   ELEVENLABS_STYLE            0=neutral/clearest … 1=exaggerated
#   ELEVENLABS_SPEAKER_BOOST    true adds presence/clarity
#   ELEVENLABS_OUTPUT_FORMAT    mp3_44100_192 for higher bitrate (paid tier)
# ELEVENLABS_STABILITY="0.45"
# ELEVENLABS_SIMILARITY_BOOST="0.9"
# ELEVENLABS_STYLE="0"
# ELEVENLABS_SPEAKER_BOOST="true"

# --- Seed admin (optional) -------------------------------------------------
ADMIN_EMAIL="admin@lalang.mu"
ADMIN_PASSWORD="changeme123"
