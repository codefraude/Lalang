// Lalang database schema
// Provider: PostgreSQL. Run `npm run db:migrate` to apply.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum Language {
  EN
  FR
  MFE // Mauritian Creole
}

enum Register {
  CASUAL
  BUSINESS
  SCHOOL
  TOURISM
  SOCIAL
  FORMAL
  SLANG
}

enum Engine {
  AI
  DICTIONARY
}

enum DictionaryCategory {
  FOOD
  FAMILY
  GREETINGS
  EXPRESSIONS
  SLANG
  TRADITIONAL
  GENERAL
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Lifecycle of an account. DEACTIVATED hides the profile and blocks sign-in
// until reactivated; deletion is a hard delete handled by the API.
enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum ThemePref {
  LIGHT
  DARK
  SYSTEM
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

// How a sign-in attempt was performed / its outcome, for the login history.
enum AuthMethod {
  PASSWORD
  GOOGLE
  ONE_TAP
  PASSKEY
  TOTP
}

enum AuthEventStatus {
  SUCCESS
  FAILED
  LOGOUT
}

// ---------------------------------------------------------------------------
// Auth (NextAuth / Auth.js) + identity
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  name          String?
  username      String?    @unique
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  deactivatedAt DateTime?

  // Two-factor (TOTP). `totpSecret` is encrypted at rest (AES-256-GCM).
  // `totpLastStep` is the last accepted time-step, for replay protection.
  twoFactorEnabled Boolean   @default(false)
  totpSecret       String?
  totpLastStep     Int?
  twoFactorAt      DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  accounts     Account[]
  sessions     Session[]
  translations Translation[]
  favorites    Favorite[]
  feedback     Feedback[]
  suggestions  TranslationSuggestion[]
  votes        Vote[]

  profile             UserProfile?
  settings            UserSettings?
  notificationPrefs   NotificationPreference?
  avatar              Avatar?
  deviceSessions      DeviceSession[]
  loginHistory        LoginHistory[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerificationToken[]
  emailChangeTokens   EmailChangeToken[]
  authenticators      Authenticator[]
  backupCodes         BackupCode[]

  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Extended profile, settings & preferences
// ---------------------------------------------------------------------------

/// Rich public/personal profile. Created lazily on first edit.
model UserProfile {
  id         String    @id @default(cuid())
  userId     String    @unique
  firstName  String?
  lastName   String?
  bio        String?
  phone      String?
  location   String?
  country    String? // ISO 3166-1 alpha-2
  timezone   String?
  occupation String?
  website    String?
  birthday   DateTime? @db.Date
  /// Map of platform -> url, e.g. { "github": "https://…" }. Validated with Zod.
  socials    Json      @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// App-level settings & privacy. Consolidates "UserSettings" + "UserPreferences".
model UserSettings {
  id                String            @id @default(cuid())
  userId            String            @unique
  theme             ThemePref         @default(SYSTEM)
  locale            String            @default("en")
  timezone          String?
  profileVisibility ProfileVisibility @default(PRIVATE)
  showEmail         Boolean           @default(false)
  showActivity      Boolean           @default(true)
  reducedMotion     Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Email/notification channel toggles. Security alerts cannot be disabled.
model NotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  productUpdates    Boolean  @default(true)
  securityAlerts    Boolean  @default(true)
  marketingEmails   Boolean  @default(false)
  weeklyDigest      Boolean  @default(false)
  learningReminders Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Uploaded avatar stored in-database (portable across serverless hosts).
/// Served through /api/avatar. Images are compressed client-side first.
model Avatar {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Bytes
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Sessions, devices, security history
// ---------------------------------------------------------------------------

/// A persistent, revocable sign-in. The JWT carries this row's id (`sid`);
/// every request re-checks it, so revoking a row logs that device out.
model DeviceSession {
  id           String     @id @default(cuid())
  userId       String
  method       AuthMethod @default(PASSWORD)
  userAgent    String?
  browser      String?
  os           String?
  deviceType   String? // desktop | mobile | tablet
  ip           String?
  country      String?
  city         String?
  rememberMe   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  lastActiveAt DateTime   @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Append-only log of every authentication attempt (success & failure).
model LoginHistory {
  id         String          @id @default(cuid())
  userId     String?
  email      String? // attempted email, for failed logins on unknown accounts
  method     AuthMethod      @default(PASSWORD)
  status     AuthEventStatus @default(SUCCESS)
  reason     String?
  userAgent  String?
  browser    String?
  os         String?
  deviceType String?
  ip         String?
  country    String?
  city       String?
  createdAt  DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

/// General audit trail for sensitive actions (profile edits, security changes).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Verification / recovery tokens (raw token emailed, SHA-256 hash stored)
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Passkeys (WebAuthn) & TOTP backup codes
// ---------------------------------------------------------------------------

/// A registered passkey credential. IDs/keys stored base64url-encoded.
model Authenticator {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  deviceType   String // singleDevice | multiDevice
  backedUp     Boolean   @default(false)
  transports   String[]
  name         String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time recovery codes for 2FA. `codeHash` is a bcrypt hash.
model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Translation domain
// ---------------------------------------------------------------------------

model Translation {
  id         String   @id @default(cuid())
  userId     String?
  sourceText String
  resultText String
  sourceLang Language
  targetLang Language
  register   Register @default(CASUAL)
  engine     Engine   @default(DICTIONARY)
  createdAt  DateTime @default(now())

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  favorites Favorite[]
  feedback  Feedback[]

  @@index([userId])
  @@index([sourceLang, targetLang])
}

model Favorite {
  id            String   @id @default(cuid())
  userId        String
  translationId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  translation Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@unique([userId, translationId])
}

model Feedback {
  id            String   @id @default(cuid())
  userId        String?
  translationId String?
  rating        Int // 1..5, or -1/1 for thumbs
  comment       String?
  createdAt     DateTime @default(now())

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  translation Translation? @relation(fields: [translationId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Cultural dictionary
// ---------------------------------------------------------------------------

model DictionaryEntry {
  id            String             @id @default(cuid())
  headword      String
  language      Language
  partOfSpeech  String?
  meaningEn     String
  meaningFr     String?
  category      DictionaryCategory @default(GENERAL)
  level         Level              @default(BEGINNER)
  pronunciation String?
  examples      String[]
  approved      Boolean            @default(true)
  createdById   String?
  createdAt     DateTime           @default(now())

  dailyWords DailyWord[]

  @@unique([headword, language])
  @@index([category])
  @@index([level])
}

model DailyWord {
  id      String          @id @default(cuid())
  date    DateTime        @unique @db.Date
  entryId String
  entry   DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Community improvement + moderation
// ---------------------------------------------------------------------------

model TranslationSuggestion {
  id            String           @id @default(cuid())
  createdById   String
  sourceText    String
  sourceLang    Language
  targetLang    Language
  suggestedText String
  note          String?
  status        SuggestionStatus @default(PENDING)
  createdAt     DateTime         @default(now())

  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  votes     Vote[]

  @@index([status])
}

model Vote {
  id           String @id @default(cuid())
  userId       String
  suggestionId String
  value        Int // +1 or -1

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestion TranslationSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([userId, suggestionId])
}
